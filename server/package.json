{
	"name": "beacon-app-server",
	"version": "1.0.0",
	"scripts": {
		"server": "ts-node src/server.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"eval": "ts-node src/eval/run.ts",
		"probe": "ts-node src/probes/differential.ts",
		"suite:roleplay": "ts-node src/probes/roleplay-suite.ts",
		"dev": "echo \"🫣 Wrong folder?: 'npm run dev' should be run in ./client directory\" && echo \"💡 Try: 'cd client && npm run dev'\" && exit 1"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"cors": "^2.8.5",
		"dotenv": "^17.4.2",
		"express": "^4.18.2",
		"express-rate-limit": "^8.5.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.13",
		"@types/express": "^4.17.17",
		"@types/node": "^26.1.1",
		"@types/supertest": "^7.2.0",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.0",
		"vitest": "^4.1.10"
	}
}
