{
	"name": "beacon-app-server",
	"version": "1.0.0",
	"scripts": {
		"server": "ts-node src/server.ts",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"eval": "ts-node src/eval/run.ts",
		"probe": "ts-node src/probes/differential.ts",
		"dev": "echo \"🫣 Wrong folder?: 'npm run dev' should be run in ./client directory\" && echo \"💡 Try: 'cd client && npm run dev'\" && exit 1"
	},
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node",
		"rootDir": "src",
		"globals": {
			"ts-jest": {
				"tsconfig": "tsconfig.test.json"
			}
		}
	},
	"dependencies": {
		"@deepgram/sdk": "^3.8.0",
		"cors": "^2.8.5",
		"dotenv": "^17.4.2",
		"express": "^4.18.2",
		"multer": "^1.4.5-lts.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.13",
		"@types/express": "^4.17.17",
		"@types/jest": "^30.0.0",
		"@types/multer": "^1.4.12",
		"@types/node": "^26.1.1",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.11",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.0"
	}
}
