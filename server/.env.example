# Copy to .env and fill in real values. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── AI / Voice ────────────────────────────────────────────────────────────────
# Priority: OPENAI_API_KEY → GEMINI_API_KEY → fixture (no key needed for dev)
OPENAI_API_KEY=
# Defaults to gpt-4o-mini. Other options: gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
HUME_API_KEY=
# Pinned role-play model; recorded in traces. Defaults to gemini-2.5-flash.
TRAVELER_MODEL=

# ── Auth (Priority 3) ─────────────────────────────────────────────────────────
# Leave blank to disable auth (open dev mode).
# Set to any long random string in production: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRY=8h

# ── CORS (Priority 4) ────────────────────────────────────────────────────────
# Restrict to your frontend origin in production. Leave blank to allow all.
ALLOWED_ORIGIN=http://localhost:5173

# ── Rate limiting (Priority 5) ───────────────────────────────────────────────
# Max session creations per IP per minute. Defaults to 20.
RATE_LIMIT_MAX=20
