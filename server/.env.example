# Copy to .env and fill in real values. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── AI ────────────────────────────────────────────────────────────────────────
# Role-play LLM priority: GROQ → OLLAMA → OPENAI → TRAVELER_API_* → GEMINI → fixture
# (fixture needs no key — the $0 keyless loop).
# Team strategy: Groq free tier for shared/live work; Ollama for unlimited
# local iteration. Voice-out is descoped for v1.
# Groq free tier: https://console.groq.com → API key
GROQ_API_KEY=
# Local Ollama: set the model to enable (e.g. llama3.3). No key needed.
OLLAMA_MODEL=
OLLAMA_BASE_URL=
OPENAI_API_KEY=
# Defaults to gpt-4o-mini. Other options: gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini
# Any other OpenAI-compatible host (e.g. Cerebras): both required
TRAVELER_API_KEY=
TRAVELER_API_BASE=
GEMINI_API_KEY=
HUME_API_KEY=
# Pinned role-play model, recorded in traces.
# Defaults: groq → llama-3.3-70b-versatile, gemini → gemini-3.5-flash
TRAVELER_MODEL=
# Probe pacing between turns, ms (defaults: 12000 with Groq — its free tier
# limits TOKENS/min and history grows per turn; 7000 otherwise; 0 = no pacing)
PROBE_TURN_DELAY_MS=

# ── CORS (Priority 4) ────────────────────────────────────────────────────────
# Restrict to your frontend origin in production. Leave blank to allow all.
ALLOWED_ORIGIN=http://localhost:5173

# ── Rate limiting (Priority 5) ───────────────────────────────────────────────
# Max session creations per IP per minute. Defaults to 20.
RATE_LIMIT_MAX=20


# Max trainee turns (model calls) per IP per minute. Defaults to 20.
  TURN_RATE_LIMIT_MAX=

  # ── Hosting (production)
  ─────────────────────────────────────────────────────
  # Signs the anonymous trainee-id cookie. REQUIRED when NODE_ENV=production
  # (generate with: openssl rand -hex 32).
  SESSION_SECRET=
  # Bearer token for POST/DELETE /api/scenarios in production. Unset = closed.
  AUTHORING_TOKEN=
  # Proxy hops to trust for client IPs (1 on Fly/Railway). Unset locally.
  TRUST_PROXY=
  # Where sessions/reports/traces persist. Defaults to server/data.
  DATA_DIR=
  # Built client served by Express in production. Defaults to client/dist.
  CLIENT_DIST=
  # Commit recorded as prompt_version in traces (containers have no .git).
  GIT_SHA=