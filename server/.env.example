# Copy to .env and fill in real values. Never commit .env.

# Role-play LLM — first key found wins (see src/traveler/index.ts):
# 1. Groq free tier (recommended dev loop): https://console.groq.com → API key
GROQ_API_KEY=
# 2. Any OpenAI-compatible host (e.g. Cerebras): both required
TRAVELER_API_KEY=
TRAVELER_API_BASE=
# 3. Gemini (free-tier rate limits are tight; fine for occasional runs)
GEMINI_API_KEY=
# No key at all = fixture traveler ($0, canned replies)

# Pinned model, recorded in traces. Defaults: groq → llama-3.3-70b-versatile, gemini → gemini-3.5-flash
TRAVELER_MODEL=

# Voice (teammate's lane)
HUME_API_KEY=

# Probe pacing between turns, ms (defaults: 12000 with Groq — its free tier
# limits TOKENS/min and history grows per turn; 7000 otherwise; 0 = no pacing)
PROBE_TURN_DELAY_MS=
